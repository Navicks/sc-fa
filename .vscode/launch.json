{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI - API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.api:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Python Debugger: FastAPI - site",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.site:app",
                "--host", "0.0.0.0",
                "--port", "8001",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Playwright: E2E (localhost:8000)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["playwright", "test"],
            "cwd": "${workspaceFolder}/e2e-tests",
            "env": {
                "BASE_URL": "http://localhost:8000"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ],
    "compounds": [
        {
            "name": "FastAPI + E2E (Test)",
            "configurations": [
                "Python Debugger: FastAPI - API",
                "Playwright: E2E (localhost:8000)"
            ],
            "stopAll": true
        }
    ]
}